# 深惠人生 · server settings. Copy to standalone/.env (git-ignored) and fill in.
# Step-by-step: docs/LAUNCH-SETUP.md

# ---- basics ----
PORT=8787
HOST=127.0.0.1
# behind nginx / a load balancer: take the real client IP from X-Forwarded-For
TRUST_PROXY=0
# admin page at /#admin (12+ random characters)
ADMIN_TOKEN=

# ---- login codes ----
# Email through Resend (https://resend.com): API key + a sender on a verified domain
RESEND_API_KEY=
LOGIN_FROM=深惠人生 <login@your-domain.com>
# SMS for overseas numbers through Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# either a sending number (+1…) or a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Any other provider (e.g. Aliyun / Tencent Cloud SMS for mainland numbers): the server POSTs
# {provider, to, code} as JSON to this URL; the secret is sent as "Authorization: Bearer …"
LOGIN_CODE_WEBHOOK=
LOGIN_CODE_WEBHOOK_SECRET=

# ---- payments (Stripe, https://dashboard.stripe.com) ----
# test keys start with sk_test_ — switch to sk_live_ only after a full test run
STRIPE_SECRET_KEY=
# from the webhook endpoint you add for https://your-domain.com/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=
# usd (default) or another currency your Stripe account supports
STRIPE_CURRENCY=usd

# ---- local testing only — must stay off in production ----
# show login codes on the page / simulate payments
DEV_LOGIN_CODES=0
DEV_PAYMENTS=0
# 1 = DMs and parties work without an account (testing)
SOCIAL_REQUIRES_ACCOUNT=1
