// Bay Area Life 2.0 — offline navmesh bake for the Shenzhen slice.
//
// The runtime Recast build takes 19-26 s at cs = 0.5 m (too slow for a
// loading screen), so the navmesh is baked ONCE here and shipped as
// base64 text in `client/src/world2/data/navmesh.b64.ts`. The game loads
// it with `loadNavMeshFromBase64` (fast, no rasterization) and only falls
// back to the runtime build if the baked file is missing.
//
// Run from the repo root:
//   cd standalone && ./node_modules/.bin/tsx bake_navmesh.mts
// (the script must live under standalone/ so `recast-navigation`
// resolves from standalone/node_modules.)
//
// The bake also verifies the bytes: determinism (bake twice, same
// sha256), load + path + crowd smoke, and equivalence with a fresh
// runtime build (same endpoints reachable, no path point in a building).

import { createHash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import {
  bakeNavMeshData,
  buildNavMesh,
  createCrowd,
  loadNavMesh,
} from "../client/src/world2/nav";
import type { SliceCity } from "../client/src/world2/cityData";

const ROOT = resolve(import.meta.dirname, "..");
const CITY_PATH = resolve(ROOT, "client/src/world2/data/slice-city.json");
const OUT_PATH = resolve(ROOT, "client/src/world2/data/navmesh.b64.ts");

const city = JSON.parse(readFileSync(CITY_PATH, "utf8")) as SliceCity;

function pointInPolygon(
  p: [number, number],
  poly: [number, number][],
): boolean {
  const [x, z] = p;
  let inside = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, zi] = poly[i]!;
    const [xj, zj] = poly[j]!;
    if (zi > z !== zj > z && x < ((xj - xi) * (z - zi)) / (zj - zi) + xi) {
      inside = !inside;
    }
  }
  return inside;
}
const inAnyBuilding = (p: [number, number]): boolean =>
  city.buildings.some(
    (b) => b.footprint.length >= 3 && pointInPolygon(p, b.footprint),
  );

const t0 = Date.now();
const bytes = await bakeNavMeshData(city.walkable, city.buildings);
const bakeMs = Date.now() - t0;
const sha256 = createHash("sha256").update(bytes).digest("hex");

// Determinism: bake a second time, same bytes.
const bytes2 = await bakeNavMeshData(city.walkable, city.buildings);
const sha256b = createHash("sha256").update(bytes2).digest("hex");
if (sha256 !== sha256b) {
  throw new Error(
    `navmesh bake is NOT deterministic: ${sha256} vs ${sha256b}`,
  );
}

// Verify the baked bytes load and behave.
const nav = await loadNavMesh(bytes);
const shop = city.buildings.find((b) => b.enterable?.role === "shop");
const office = city.buildings.find((b) => b.enterable?.role === "office");
if (!shop || !office) throw new Error("enterable shop/office not found");
const shopDoor: [number, number] = [-51.7, 86.2];
const officeDoor: [number, number] = [238.2, 216.4];
const lobbyDoor: [number, number] = [154.6, 245.4];
const path = nav.findPath(shopDoor, officeDoor);
if (path.length === 0) throw new Error("baked navmesh: shop->office path empty");
if (path.some(inAnyBuilding)) {
  throw new Error("baked navmesh: path point inside a building");
}
const lobbyPath = nav.findPath(lobbyDoor, shopDoor);
if (lobbyPath.length === 0) throw new Error("baked navmesh: lobby->shop path empty");
if (lobbyPath.some(inAnyBuilding)) {
  throw new Error("baked navmesh: lobby path point inside a building");
}
let randomOk = 0;
for (let i = 0; i < 20; i++) {
  const p = nav.randomPointNear(0, 0, 100);
  if (p && !inAnyBuilding(p)) randomOk++;
}
if (randomOk < 20) throw new Error(`baked navmesh: randomPointNear ${randomOk}/20 ok`);
const crowd = createCrowd(nav, 4);
const a0 = crowd.addAgent(shopDoor[0], shopDoor[1]);
crowd.goto(a0, officeDoor[0], officeDoor[1]);
for (let i = 0; i < 100; i++) crowd.update(0.1);
const end = crowd.position(a0);
const moved = Math.hypot(end[0] - shopDoor[0], end[1] - shopDoor[1]);
if (moved < 5) throw new Error(`baked navmesh: crowd agent barely moved (${moved}m)`);

// Equivalence: a fresh runtime build must reach the same endpoints.
const rt = await buildNavMesh(city.walkable, city.buildings);
const rtPath = rt.findPath(shopDoor, officeDoor);
if (rtPath.length === 0) throw new Error("runtime navmesh: shop->office path empty");
if (rtPath.some(inAnyBuilding)) {
  throw new Error("runtime navmesh: path point inside a building");
}

const b64 = Buffer.from(bytes).toString("base64");
const meta = {
  version: "1.0",
  timestamp_osm_base: city.timestamp_osm_base,
  source: city.source,
  cellSizeM: 0.5,
  byteLength: bytes.length,
  base64Length: b64.length,
  sha256,
};
writeFileSync(
  OUT_PATH,
  `// GENERATED by standalone/bake_navmesh.mts — do not hand-edit.\n` +
    `// Source: client/src/world2/data/slice-city.json (OSM base ${city.timestamp_osm_base}).\n` +
    `// Re-bake after any slice-city.json change: cd standalone && ./node_modules/.bin/tsx bake_navmesh.mts\n` +
    `export const NAVMESH_META = ${JSON.stringify(meta, null, 2)} as const;\n` +
    `export const NAVMESH_B64 = "${b64}";\n`,
);

console.log(`bake: ${bytes.length} bytes in ${bakeMs} ms (deterministic sha256 ${sha256.slice(0, 16)}…)`);
console.log(`verify: baked path ${path.length} pts, lobby path ${lobbyPath.length} pts, random 20/20, crowd moved ${moved.toFixed(1)} m, runtime path ${rtPath.length} pts — all OK`);
console.log(`wrote ${OUT_PATH}`);
